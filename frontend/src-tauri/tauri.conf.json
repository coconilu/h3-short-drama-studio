{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "镜场",
  "version": "0.2.0",
  "identifier": "com.jingchang.h3studio",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "MiniMax H3 本地短剧生产工作台",
    "longDescription": "管理剧本、生产圣经、H3 生成、审片、装配与横屏交付。",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
